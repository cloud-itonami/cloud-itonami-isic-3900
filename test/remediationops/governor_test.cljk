(ns remediationops.governor-test
  "Pure unit tests of `remediationops.governor/check` against
  hand-built proposals -- the fast, focused complement to
  `governor-contract-test`'s full-graph integration coverage."
  (:require [kotoba.test :refer [deftest is testing]]
            [remediationops.governor :as gov]
            [remediationops.store :as store]))

(def site-1 {:site-id "brownfield-site-1" :name "Riverside Brownfield Remediation Site" :registered? true :verified? true})
(def site-3 {:site-id "closure-site-3" :name "Old Millworks Site" :registered? true :verified? false})

(defn- clean-proposal
  ([op site-id] (clean-proposal op site-id {}))
  ([op site-id value]
   {:op op :site-id site-id :summary "s" :rationale "routine back-office coordination"
    :cites [site-id] :effect :propose :value value :confidence 0.85}))

(deftest site-unregistered-is-hard
  (testing "no site record at all -> HARD hold"
    (let [s (store/mem-store {"brownfield-site-1" site-1})
          verdict (gov/check {} nil (clean-proposal :log-remediation-record "unknown-site") s)]
      (is (true? (:hard? verdict)))
      (is (some #{:site-unverified} (map :rule (:violations verdict)))))))

(deftest site-unverified-is-hard
  (testing "site registered but not yet verified -> HARD hold"
    (let [s (store/mem-store {"closure-site-3" site-3})
          verdict (gov/check {} nil (clean-proposal :log-remediation-record "closure-site-3") s)]
      (is (true? (:hard? verdict)))
      (is (some #{:site-unverified} (map :rule (:violations verdict)))))))

(deftest effect-not-propose-is-hard
  (testing "any :effect other than :propose is a HARD, un-overridable block"
    (let [s (store/mem-store {"brownfield-site-1" site-1})
          verdict (gov/check {} nil (assoc (clean-proposal :coordinate-disposal "brownfield-site-1") :effect :commit) s)]
      (is (true? (:hard? verdict)))
      (is (some #{:effect-not-propose} (map :rule (:violations verdict)))))))

(deftest op-outside-allowlist-is-hard
  (testing "an op outside the closed four-op allowlist is a scope violation"
    (let [s (store/mem-store {"brownfield-site-1" site-1})
          verdict (gov/check {} nil (clean-proposal :operate-excavator "brownfield-site-1") s)]
      (is (true? (:hard? verdict)))
      (is (some #{:op-not-allowed} (map :rule (:violations verdict)))))))

(deftest excavation-treatment-control-content-is-hard-and-permanent
  (testing "a proposal whose rationale touches excavation/treatment-equipment-control scope is HARD-blocked regardless of op/confidence"
    (let [s (store/mem-store {"brownfield-site-1" site-1})
          poisoned (assoc (clean-proposal :schedule-remediation-operation "brownfield-site-1")
                          :rationale "adjusted excavation equipment control and treatment plant actuation timing"
                          :confidence 0.99)
          verdict (gov/check {} nil poisoned s)]
      (is (true? (:hard? verdict)))
      (is (some #{:scope-excluded} (map :rule (:violations verdict)))))))

(deftest site-closure-certification-content-is-hard
  (testing "a proposal touching regulatory site-closure-certification decisions (site-closure certification / remediation-completion certification / regulatory closure approval) is HARD-blocked"
    (let [s (store/mem-store {"brownfield-site-1" site-1})
          poisoned (assoc (clean-proposal :coordinate-disposal "brownfield-site-1")
                          :summary "recommend site closure certification pending review")
          verdict (gov/check {} nil poisoned s)]
      (is (true? (:hard? verdict)))
      (is (some #{:scope-excluded} (map :rule (:violations verdict)))))))

(deftest contamination-flag-always-escalates
  (testing ":flag-contamination-concern ALWAYS escalates, even at maximum confidence"
    (let [s (store/mem-store {"brownfield-site-1" site-1})
          verdict (gov/check {} nil (assoc (clean-proposal :flag-contamination-concern "brownfield-site-1") :confidence 1.0) s)]
      (is (false? (:hard? verdict)))
      (is (true? (:escalate? verdict)))
      (is (true? (:high-stakes? verdict)))
      (is (false? (:ok? verdict))))))

(deftest low-confidence-escalates
  (testing "confidence below the floor escalates a proposal that is otherwise clean"
    (let [s (store/mem-store {"brownfield-site-1" site-1})
          verdict (gov/check {} nil (assoc (clean-proposal :log-remediation-record "brownfield-site-1") :confidence 0.4) s)]
      (is (false? (:hard? verdict)))
      (is (true? (:escalate? verdict)))
      (is (false? (:ok? verdict))))))

(deftest hard-violation-wins-over-escalate
  (testing "a HARD violation on an always-escalate op still reports hard?, not merely escalate?"
    (let [s (store/mem-store {})
          verdict (gov/check {} nil (clean-proposal :flag-contamination-concern "unknown-site") s)]
      (is (true? (:hard? verdict)))
      (is (false? (:escalate? verdict)) "hard? wins -- escalate? is false when hard? is true"))))

(deftest happy-path-every-non-escalating-op-is-clean
  (testing "each of the three non-always-escalate ops, clean input, registered+verified site -> ok"
    (let [s (store/mem-store {"brownfield-site-1" site-1})]
      (doseq [op [:log-remediation-record :schedule-remediation-operation :coordinate-disposal]]
        (let [verdict (gov/check {} nil (clean-proposal op "brownfield-site-1") s)]
          (is (false? (:hard? verdict)) (str op " should have no hard violations"))
          (is (false? (:escalate? verdict)) (str op " should not escalate when clean and confident"))
          (is (true? (:ok? verdict)) (str op " should be ok")))))))
