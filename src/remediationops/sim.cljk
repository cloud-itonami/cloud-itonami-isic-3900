(ns remediationops.sim
  "Demo driver -- `kbb -M:run`. Walks a clean remediation-record
  logging request through intake -> advise -> govern -> decide ->
  approval -> commit at phase 1 (assisted-logging, always approval),
  then re-runs the same op at phase 3 (supervised-auto, clean + high
  confidence -> auto-commit), then a remediation-operation-scheduling
  request and a disposal-coordination request (also auto-commit clean
  at phase 3), then a contamination-concern flag (ALWAYS escalates, at
  any phase -- approve, then commit), then HARD-hold scenarios: an
  unregistered site, a site registered but not yet verified, a
  proposal whose own `:effect` is not `:propose`, and a proposal that
  has drifted into the permanently-excluded excavation/treatment-
  equipment-control scope."
  (:require [langgraph.graph :as g]
            [remediationops.advisor :as advisor]
            [remediationops.store :as store]
            [remediationops.operation :as op]))

(defn- exec-op [actor tid request context]
  (g/run* actor {:request request :context context} {:thread-id tid}))

(defn- approve! [actor tid]
  (g/run* actor {:approval {:status :approved :by "remediation-project-supervisor-1"}} {:thread-id tid :resume? true}))

(defn -main [& _]
  (let [db (store/seed-db)
        operator-phase-1 {:actor-id "op-1" :actor-role :remediation-project-supervisor :phase 1}
        operator-phase-3 {:actor-id "op-1" :actor-role :remediation-project-supervisor :phase 3}
        actor (op/build db)]

    (println "== log-remediation-record brownfield-site-1 (phase 1, escalates -- human approves) ==")
    (println (exec-op actor "t1" {:op :log-remediation-record :site-id "brownfield-site-1"
                                  :patch {:excavated-tons 42.5 :shift "day"}} operator-phase-1))
    (println (approve! actor "t1"))

    (println "== log-remediation-record brownfield-site-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t2" {:op :log-remediation-record :site-id "brownfield-site-1"
                                  :patch {:excavated-tons 45.1 :shift "night"}} operator-phase-3))

    (println "== schedule-remediation-operation groundwater-site-2 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t3" {:op :schedule-remediation-operation :site-id "groundwater-site-2"
                                  :patch {:operation "monitoring-well-sampling-4" :window "2026-07-22"}} operator-phase-3))

    (println "== coordinate-disposal groundwater-site-2 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t4" {:op :coordinate-disposal :site-id "groundwater-site-2"
                                  :patch {:material "treated-soil" :destination "licensed-disposal-facility-a"}} operator-phase-3))

    (println "== flag-contamination-concern brownfield-site-1 (ALWAYS escalates, even at phase 3) ==")
    (let [r (exec-op actor "t5" {:op :flag-contamination-concern :site-id "brownfield-site-1"
                                 :patch {:concern "groundwater plume migration observed" :confidence 0.95}} operator-phase-3)]
      (println r)
      (println "-- human remediation-project supervisor reviews & approves --")
      (println (approve! actor "t5")))

    (println "== log-remediation-record brownfield-site-9 (unregistered site -> HARD hold) ==")
    (println (exec-op actor "t6" {:op :log-remediation-record :site-id "brownfield-site-9"
                                  :patch {:excavated-tons 0.1}} operator-phase-3))

    (println "== log-remediation-record closure-site-3 (registered but unverified -> HARD hold) ==")
    (println (exec-op actor "t7" {:op :log-remediation-record :site-id "closure-site-3"
                                  :patch {:excavated-tons 0.1}} operator-phase-3))

    (println "== coordinate-disposal brownfield-site-1, advisor attempts direct actuation (:effect :commit) -> HARD hold ==")
    (let [actor-direct (op/build db {:advisor (reify advisor/Advisor
                                                (-advise [_ _ req]
                                                  (assoc (advisor/infer db req) :effect :commit)))})]
      (println (exec-op actor-direct "t8" {:op :coordinate-disposal :site-id "brownfield-site-1"
                                           :patch {:material "recovered-soil"}} operator-phase-3)))

    (println "== schedule-remediation-operation brownfield-site-1, advisor drifts into excavation-equipment-control scope -> HARD hold, permanent ==")
    (println (exec-op actor "t9" {:op :schedule-remediation-operation :site-id "brownfield-site-1"
                                   :out-of-scope? true
                                   :patch {}} operator-phase-3))

    (println "== audit ledger ==")
    (doseq [f (store/ledger db)] (println f))

    (println "== committed coordination log ==")
    (doseq [r (store/coordination-log db)] (println r))))
